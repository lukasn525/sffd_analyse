% -------------------------------------------------------------------------
% 13  LOCATION QUOTIENT - der Kriminalitaetsindex
% -------------------------------------------------------------------------
% Belegt, dass der relative Index kein Eigenbau ist, sondern die
% kriminologische Uebernahme eines Masses der Regionalwissenschaft.
%   S. 268  Gleichung (1), der Location Quotient in seiner regional-
%           wissenschaftlichen Grundform (nach Klosterman et al. 1993):
%           Anteil einer Kategorie in einem Gebiet, geteilt durch denselben
%           Anteil in einem Vergleichsgebiet
%   S. 269  Gleichung (2), dieselbe Groesse in kriminologischer Form (LQC)
%
% WICHTIG, UNTERSCHIED ZUR EIGENEN KONSTRUKTION - beim Schreiben von 5.3
% zu benennen, sonst ist es im Kolloquium eine offene Flanke:
% Der LQC bei Brantingham hat als BEZUGSGROESSE ALLE STRAFTATEN des
% Gebiets; er misst, worauf ein Gebiet relativ SPEZIALISIERT ist, und
% kommt bewusst ohne Einwohnerzahl aus ("there is no need to obtain a
% count of the number of targets as is necessary in calculating a crime
% rate", S. 269). Der Index dieser Arbeit hat als Bezugsgroesse die
% EINWOHNERZAHL. Er ist damit algebraisch ebenfalls ein Location Quotient -
% Anteil der Stadt-Delikte im Stadtteil geteilt durch dessen
% Bevoelkerungsanteil -, misst aber die relative BELASTUNG je Einwohner,
% nicht die Deliktspezialisierung. Formulierung fuer 5.3: die Konstruktion
% folgt der Form des Location Quotient, verwendet aber die Wohnbevoelkerung
% als Bezugsgroesse. Nicht schreiben "der Index ist ein LQC".
%% verwendet = 5.3
%% link      = https://popcenter.asu.edu/sites/default/files/library/CrimePrevention/Volume_08/index-2.html
%% seiten    = 268 (Gl. 1, LQ der Regionalwissenschaft), 269 (Gl. 2, LQC) - Volltext frei, liegt in Quellen/brantingham1998.pdf
@incollection{Brantingham1997,
  author      = {Brantingham, Patricia L. and Brantingham, Paul J.},
  title       = {Mapping Crime for Analytic Purposes: Location Quotients,
                 Counts, and Rates},
  booktitle   = {Crime Mapping and Crime Prevention},
  editor      = {Weisburd, David and McEwen, Tom},
  series      = {Crime Prevention Studies},
  volume      = {8},
  publisher   = {Criminal Justice Press},
  location    = {Monsey, NY},
  year        = {1997},
  pages       = {263--288},
  url         = {https://popcenter.asu.edu/sites/default/files/library/CrimePrevention/Volume_08/index-2.html},
  urldate     = {2026-08-24},
  note        = {Herausgegeben von Willow Tree Press. Volltext frei ueber das
                 ASU Center for Problem-Oriented Policing},
}


% -------------------------------------------------------------------------
% 14  POISSON-PSEUDO-MAXIMUM-LIKELIHOOD - warum nicht Negative Binomial
% -------------------------------------------------------------------------
% NACHTRAG 24.08.2026: Die Econometrica-Fassung von 1984 liegt hinter der
% JSTOR-Schranke. Zitiert wird deshalb die frei zugaengliche Arbeitspapier-
% fassung derselben Arbeit - gleicher Titel, gleiche drei Autoren. Die
% Veroeffentlichung steht im note-Feld, damit die Zuordnung eindeutig bleibt.
% Das ist die saubere Loesung: zitiert wird, was gelesen wurde.
%
% Traegt genau einen Satz in 5.4: Der Poisson-Schaetzer bleibt konsistent,
% wenn der bedingte Mittelwert richtig spezifiziert ist - auch wenn die wahre
% Verteilung keine Poisson-Verteilung ist. Beschaedigt werden die
% Standardfehler, und die verwendet eine Baseline mit reinen Punktvorhersagen
% nicht. Damit ist die Ueberdispersion (Index 62,8) kein Argument gegen das
% Poisson-GLM als Stufe-2-Baseline.
%   S. 5  Abschnitt 2.b, Poisson-Modell mit Spezifikationsfehler: der
%         ML-Schaetzer der Alternative kann inkonsistent werden, gesucht sind
%         "simple estimation methods leading to consistent estimators for all
%         possible distribution[s]"
%
% ACHTUNG BEI DER JAHRESANGABE: Interne Notizen (03_STAND, 06_RISIKEN,
% 07_BEFUNDE, 08_FUNKTIONSDOKUMENTATION) nennen "Gourieroux, Monfort &
% Trognon 1984". Im Fliesstext der Arbeit steht die Stelle noch nicht - dort
% also 1981 schreiben, passend zum Eintrag. Die Notizen koennen so bleiben,
% sie meinen dasselbe Resultat.
%% verwendet = 5.4
%% link      = http://www.cepremap.fr/depot/couv_orange/co8203.pdf
%% seiten    = 5 (Konsistenz bei Spezifikationsfehler) - Volltext frei, 25 Seiten
@report{Gourieroux1981,
  author      = {Gourieroux, Christian and Monfort, Alain and
                 Trognon, Alain},
  title       = {Pseudo Maximum Likelihood Methods: Applications to Poisson
                 Models},
  type        = {Arbeitspapier},
  institution = {CEPREMAP},
  location    = {Paris},
  number      = {8203},
  date        = {1981-12},
  pagetotal   = {25},
  url         = {http://www.cepremap.fr/depot/couv_orange/co8203.pdf},
  urldate     = {2026-08-24},
  note        = {Reihe Couverture Orange, Nr. 8203; RePEc fuehrt das Papier
                 unter dem Jahrgang 1982. Erschienen als: Econometrica 52(3),
                 1984, S. 701--720, \url{https://doi.org/10.2307/1913472}},
}


