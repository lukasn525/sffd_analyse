% -------------------------------------------------------------------------
% 1  CRISP-DM - das Referenzhandbuch
% -------------------------------------------------------------------------
% Loest die Paginierungsfalle von Wirth2000 (Tagungsband 29-39, SCIRP 29-40,
% freie Kopie ab 1) fuer alle Stellen, an denen auf Phasen, Aufgaben oder
% Outputs des Prozessmodells verwiesen wird. Die Data-Understanding-Phase
% mit ihren vier Aufgaben steht auf S. 20-22: 2.1 Collect initial data,
% 2.2 Describe data, 2.3 Explore data, 2.4 Verify data quality.
%% verwendet = 2.8; 3.1; 4.1; 4.2
%% link      = https://public.dhe.ibm.com/software/analytics/spss/documentation/modeler/14.2/es/CRISP-DM.pdf
%% seiten    = 20-22 (Data Understanding), 16-19 (Business Understanding) - Volltext frei, liegt in Quellen/Chapman2000.pdf
@report{Chapman2000,
  author      = {Chapman, Pete and Clinton, Julian and Kerber, Randy and
                 Khabaza, Thomas and Reinartz, Thomas and Shearer, Colin and
                 Wirth, R{\"u}diger},
  title       = {{CRISP-DM} 1.0: Step-by-step Data Mining Guide},
  type        = {Referenzhandbuch},
  institution = {The {CRISP-DM} Consortium},
  year        = {2000},
  pagetotal   = {78},
  url         = {https://public.dhe.ibm.com/software/analytics/spss/documentation/modeler/14.2/es/CRISP-DM.pdf},
  urldate     = {2026-08-22},
  note        = {Herausgegeben von SPSS Inc. Spiegelung ebenfalls unter
                 \url{https://www.kde.cs.uni-kassel.de/wp-content/uploads/lehre/ws2012-13/kdd/files/CRISPWP-0800.pdf}},
}


% -------------------------------------------------------------------------
% 2  NFIRS - die Kodierung der Einsatzart
% -------------------------------------------------------------------------
% Traegt die Zielgroesse des Strukturstrangs. Die Uebersicht der neun
% Codeserien steht auf S. 3-21, die vollstaendige Codeliste ab S. 3-22:
%   100 Fire | 200 Overpressure Rupture, Explosion, Overheat (No Fire)
%   300 Rescue and Emergency Medical Service (EMS) Incidents
%   400 Hazardous Condition (No Fire) | 500 Service Call
%   600 Good Intent Call | 700 False Alarm and False Call
%   800 Severe Weather and Natural Disaster | 900 Special Incident Type
% Die Zusammenfassung dieser Serien zu vier Klassen ist eine Entscheidung
% der Arbeit und gehoert nach 5.3 - hier steht nur die Quelle der Kodierung.
%% verwendet = 4.1; 5.3
%% link      = https://www.usfa.fema.gov/downloads/pdf/nfirs/nfirs_complete_reference_guide_2015.pdf
%% seiten    = 3-21 (Serienuebersicht), 3-22 ff. (Codeliste) - Volltext frei, liegt in Quellen/nfirs_complete_reference_guide_2015.pdf
@report{USFA2015,
  author      = {{U.S. Fire Administration}},
  title       = {National Fire Incident Reporting System 5.0 Complete
                 Reference Guide},
  type        = {Referenzhandbuch},
  institution = {National Fire Data Center, U.S. Fire Administration},
  location    = {Emmitsburg, MD},
  date        = {2015-01},
  pagetotal   = {512},
  url         = {https://www.usfa.fema.gov/downloads/pdf/nfirs/nfirs_complete_reference_guide_2015.pdf},
  urldate     = {2026-08-22},
}


% -------------------------------------------------------------------------
% 3  ACS - Periodenschaetzung und Publikationsversatz
% -------------------------------------------------------------------------
% Belegt zwei Befunde in 4.2 und die Regel acs_jahr <= Einsatzjahr - 1 in 5.2:
%   S. 13  eine 5-Jahres-Schaetzung ist eine PERIODENschaetzung: "In the case
%          of ACS multiyear estimates, the period is 5 calendar years (e.g.,
%          the 2014-2018 ACS estimates cover the period from January 2014
%          through December 2018)."
%   S. 14  Abbildung 3.1 stellt Erhebungszeitraum gegen Veroeffentlichungs-
%          jahr - das ist der Publikationsversatz in einem Bild
%   S. 16  Tabelle 3.1 fuehrt die 5-Jahres-Schaetzung ausdruecklich als
%          "Least current"
%% verwendet = 4.2; 5.2
%% link      = https://www.census.gov/content/dam/Census/library/publications/2020/acs/acs_general_handbook_2020_ch03.pdf
%% seiten    = 13 (Periodenschaetzung), 14 (Abb. 3.1), 16 (Tab. 3.1) - Volltext frei, liegt in Quellen/us_cencus_bureau.pdf
@inbook{CensusBureau2020,
  author      = {{U.S. Census Bureau}},
  title       = {Understanding and Using {ACS} Single-Year and Multiyear
                 Estimates},
  booktitle   = {Understanding and Using American Community Survey Data:
                 What All Data Users Need to Know},
  chapter     = {3},
  pages       = {13--16},
  publisher   = {U.S. Government Publishing Office},
  location    = {Washington, DC},
  date        = {2020-10},
  url         = {https://www.census.gov/content/dam/Census/library/publications/2020/acs/acs_general_handbook_2020_ch03.pdf},
  urldate     = {2026-08-22},
}


